spring.application.name=catalog-service

server.port=8083

# PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/catalogue_db
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME
# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.show-sql=true


app.upload-dir=${UPLOAD_DIR:uploads/medicaments}
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=2MB


# eureka registration
eureka.client.service-url.defaultZone=http://localhost:8761/eureka
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
eureka.instance.prefer-ip-address=true


# Actuator
# Exposer les endpoints health, info et metrics (seul health l'est par défaut)
management.endpoints.web.exposure.include=health,info,metrics

# Afficher le détail des composants dans /health (db, diskSpace, ping…)
management.endpoint.health.show-details=always

# Variante : afficher les composants sans leurs détails
#management.endpoint.health.show-components=always

# Transmettre à Eureka le statut de /health (Job passe DOWN si la base tombe)
eureka.client.healthcheck.enabled=true

# Publier les propriétés info.* dans /actuator/info (désactivé par défaut)
management.info.env.enabled=true

# Contenu affiché par /actuator/info
info.app.name=catalog-service
info.app.version=1.0.0
info.app.description=Microservice du catalogue des médicaments


