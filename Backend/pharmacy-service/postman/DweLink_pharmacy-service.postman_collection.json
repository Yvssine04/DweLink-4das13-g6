    {
      "name": "2. OpenFeign + Resilience4j (appel à user-service)",
      "item": [
        {
          "name": "Créer une pharmacie (pharmacien) → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Utilisateur-Id",
                "value": "{{pharmacienId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pharmacies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pharmacies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Pharmacie Test Complet\",\n  \"numeroAutorisation\": \"{{numero}}\",\n  \"adresse\": \"10 avenue Habib Bourguiba\",\n  \"ville\": \"Tunis\",\n  \"latitude\": 36.80,\n  \"longitude\": 10.18,\n  \"telephone\": \"+216 71 333 333\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"numero\", \"AUT-\" + Date.now()); // numéro unique à chaque exécution"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test(\"Statut EN_ATTENTE\", () => pm.expect(p.statut).to.eql(\"EN_ATTENTE\"));",
                  "pm.collectionVariables.set(\"pharmacieId\", p.id);"
                ]
              }
            }
          ]
        },
